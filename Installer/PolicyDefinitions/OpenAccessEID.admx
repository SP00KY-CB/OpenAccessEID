<?xml version="1.0" encoding="utf-8"?>
<!--
  OpenAccess EID - Group Policy administrative template

  This ADMX exposes the custom policies introduced by the OpenAccess EID
  product. Most of the smart-card credential-provider policies consumed by
  the product (AllowSignatureOnlyKeys, AllowIntegratedUnblock,
  CertPropEnabledString, FilterDuplicateCertificates, etc.) are already
  defined in the Windows-shipped SmartCard.admx and are respected directly
  from the same registry hive. Only the product-specific policies are
  defined below.

  Registry location (all values): HKLM\SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider
-->
<policyDefinitions revision="1.0" schemaVersion="1.0">
  <policyNamespaces>
    <target prefix="oaeid" namespace="OpenAccessEID.Policies" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>

  <resources minRequiredRevision="1.0" />

  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_EIDAuth_1_0" displayName="$(string.SUPPORTED_EIDAuth_1_0)" />
    </definitions>
  </supportedOn>

  <categories>
    <category name="OpenAccessEID" displayName="$(string.Cat_OpenAccessEID)">
      <parentCategory ref="windows:WindowsComponents" />
    </category>
    <category name="EIDLogging" displayName="$(string.Cat_EIDLogging)">
      <parentCategory ref="OpenAccessEID" />
    </category>
  </categories>

  <policies>

    <policy name="EnforceCSPWhitelist"
            class="Machine"
            displayName="$(string.EnforceCSPWhitelist)"
            explainText="$(string.EnforceCSPWhitelist_Help)"
            key="SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider"
            valueName="EnforceCSPWhitelist">
      <parentCategory ref="OpenAccessEID" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="RequireCardBoundCredentials"
            class="Machine"
            displayName="$(string.RequireCardBoundCredentials)"
            explainText="$(string.RequireCardBoundCredentials_Help)"
            key="SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider"
            valueName="RequireCardBoundCredentials">
      <parentCategory ref="OpenAccessEID" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue>
        <decimal value="1" />
      </enabledValue>
      <disabledValue>
        <decimal value="0" />
      </disabledValue>
    </policy>

    <policy name="RequireRevocationCheck"
            class="Machine"
            displayName="$(string.RequireRevocationCheck)"
            explainText="$(string.RequireRevocationCheck_Help)"
            key="SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider"
            valueName="RequireRevocationCheck">
      <parentCategory ref="OpenAccessEID" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <!-- Wrong-PIN protection at the logon / unlock tile. Not configured or disabled = the
         defaults (5 wrong PINs, then 10 seconds; 1 card attempt held back). -->
    <policy name="PinEntryDelay"
            class="Machine"
            displayName="$(string.PinEntryDelay)"
            explainText="$(string.PinEntryDelay_Help)"
            key="SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider"
            presentation="$(presentation.PinEntryDelay)">
      <parentCategory ref="OpenAccessEID" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="PinDelayThreshold_Dec" valueName="PinDelayThreshold" minValue="1" maxValue="100" />
        <decimal id="PinDelaySeconds_Dec" valueName="PinDelaySeconds" minValue="0" maxValue="300" />
      </elements>
    </policy>

    <policy name="PinAttemptsReserved"
            class="Machine"
            displayName="$(string.PinAttemptsReserved)"
            explainText="$(string.PinAttemptsReserved_Help)"
            key="SOFTWARE\Policies\Microsoft\Windows\SmartCardCredentialProvider"
            presentation="$(presentation.PinAttemptsReserved)">
      <parentCategory ref="OpenAccessEID" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="PinAttemptsReserved_Dec" valueName="PinAttemptsReserved" minValue="0" maxValue="10" />
      </elements>
    </policy>

    <!-- ============ EIDLogManager settings (SOFTWARE\Policies\OpenAccessEID\LogManager) ============ -->

    <policy name="LogCSVEnabled" class="Machine"
            displayName="$(string.LogCSVEnabled)" explainText="$(string.LogCSVEnabled_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager" valueName="CSVEnabled">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="LogCSVLogPath" class="Machine"
            displayName="$(string.LogCSVLogPath)" explainText="$(string.LogCSVLogPath_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogCSVLogPath)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <text id="LogCSVLogPath_Text" valueName="CSVLogPath" required="true" maxLength="259" />
      </elements>
    </policy>

    <policy name="LogCSVMaxFileSize" class="Machine"
            displayName="$(string.LogCSVMaxFileSize)" explainText="$(string.LogCSVMaxFileSize_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogCSVMaxFileSize)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="LogCSVMaxFileSize_Dec" valueName="CSVMaxFileSize" minValue="1" maxValue="1024" />
      </elements>
    </policy>

    <policy name="LogCSVFileCount" class="Machine"
            displayName="$(string.LogCSVFileCount)" explainText="$(string.LogCSVFileCount_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogCSVFileCount)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="LogCSVFileCount_Dec" valueName="CSVFileCount" minValue="1" maxValue="100" />
      </elements>
    </policy>

    <policy name="LogCSVColumns" class="Machine"
            displayName="$(string.LogCSVColumns)" explainText="$(string.LogCSVColumns_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogCSVColumns)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <enum id="LogCSVColumns_Enum" valueName="CSVColumns">
          <item displayName="$(string.Cols_Minimal)"><value><decimal value="115" /></value></item>
          <item displayName="$(string.Cols_Standard)"><value><decimal value="255" /></value></item>
          <item displayName="$(string.Cols_Extended)"><value><decimal value="30719" /></value></item>
          <item displayName="$(string.Cols_All)"><value><decimal value="32767" /></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="LogCSVCategoryFilter" class="Machine"
            displayName="$(string.LogCSVCategoryFilter)" explainText="$(string.LogCSVCategoryFilter_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogCSVCategoryFilter)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <enum id="LogCSVCategoryFilter_Enum" valueName="CSVCategoryFilter">
          <item displayName="$(string.Cat_AllCategories)"><value><decimal value="65535" /></value></item>
          <item displayName="$(string.Cat_SecurityCritical)"><value><decimal value="342" /></value></item>
          <item displayName="$(string.Cat_AuditOnly)"><value><decimal value="256" /></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="LogCSVVerbose" class="Machine"
            displayName="$(string.LogCSVVerbose)" explainText="$(string.LogCSVVerbose_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager" valueName="CSVVerbose">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="LogDiagnosticsEnabled" class="Machine"
            displayName="$(string.LogDiagnosticsEnabled)" explainText="$(string.LogDiagnosticsEnabled_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager" valueName="DiagnosticsEnabled">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

    <policy name="LogDiagnosticsLevel" class="Machine"
            displayName="$(string.LogDiagnosticsLevel)" explainText="$(string.LogDiagnosticsLevel_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.LogDiagnosticsLevel)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <enum id="LogDiagnosticsLevel_Enum" valueName="DiagnosticsLevel">
          <item displayName="$(string.DiagLevel_Info)"><value><decimal value="4" /></value></item>
          <item displayName="$(string.DiagLevel_Verbose)"><value><decimal value="5" /></value></item>
        </enum>
      </elements>
    </policy>

    <!-- ============ ETW trace-session settings (feed the WMI autologger) ============ -->

    <policy name="TraceLevel" class="Machine"
            displayName="$(string.TraceLevel)" explainText="$(string.TraceLevel_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.TraceLevel)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <enum id="TraceLevel_Enum" valueName="TraceLevel">
          <item displayName="$(string.Lvl_Critical)"><value><decimal value="1" /></value></item>
          <item displayName="$(string.Lvl_Error)"><value><decimal value="2" /></value></item>
          <item displayName="$(string.Lvl_Warning)"><value><decimal value="3" /></value></item>
          <item displayName="$(string.Lvl_Info)"><value><decimal value="4" /></value></item>
          <item displayName="$(string.Lvl_Verbose)"><value><decimal value="5" /></value></item>
        </enum>
      </elements>
    </policy>

    <policy name="TraceLogPath" class="Machine"
            displayName="$(string.TraceLogPath)" explainText="$(string.TraceLogPath_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.TraceLogPath)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <text id="TraceLogPath_Text" valueName="LogPath" required="true" maxLength="259" />
      </elements>
    </policy>

    <policy name="TraceMaxFileSize" class="Machine"
            displayName="$(string.TraceMaxFileSize)" explainText="$(string.TraceMaxFileSize_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.TraceMaxFileSize)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="TraceMaxFileSize_Dec" valueName="MaxFileSize" minValue="1" maxValue="1024" />
      </elements>
    </policy>

    <policy name="TraceFileCounter" class="Machine"
            displayName="$(string.TraceFileCounter)" explainText="$(string.TraceFileCounter_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager"
            presentation="$(presentation.TraceFileCounter)">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <elements>
        <decimal id="TraceFileCounter_Dec" valueName="FileCounter" minValue="1" maxValue="100" />
      </elements>
    </policy>

    <policy name="TraceAutoStart" class="Machine"
            displayName="$(string.TraceAutoStart)" explainText="$(string.TraceAutoStart_Help)"
            key="SOFTWARE\Policies\OpenAccessEID\LogManager" valueName="AutoStart">
      <parentCategory ref="EIDLogging" />
      <supportedOn ref="SUPPORTED_EIDAuth_1_0" />
      <enabledValue><decimal value="1" /></enabledValue>
      <disabledValue><decimal value="0" /></disabledValue>
    </policy>

  </policies>
</policyDefinitions>
